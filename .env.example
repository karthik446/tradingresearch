# tradingresearch settings. Copy to .env in this directory (cp .env.example .env) and fill in the keys.
# .env is git-ignored; `tr` reads it itself, so never `source` it into a shell. TR_ENV_FILE points elsewhere.
# Keys are read from this file only, never from the shell environment.

# Alpaca market data (paper account keys are enough)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Model providers: only the key of the provider TR_PROVIDER picks is needed.
# Teachers always run on OpenRouter, so `tr daily --teachers` also needs OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# SEC EDGAR asks for a name and an email in the User-Agent
TR_SEC_USER_AGENT="Your Name you@example.com"

# openrouter (default) or anthropic: who serves every model call except the teachers'
TR_PROVIDER=openrouter

# sip (default) or iex, the one-flag fallback for the Alpaca feed
TR_FEED=sip

# Where the journal, runs and traces live (default: data)
# TR_DATA_DIR=data
