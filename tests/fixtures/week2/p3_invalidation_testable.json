    {"name": "long_equal_to_entry", "expect": false, "reference_close": 100.0, "thesis": {"direction": "long", "entry_kind": "stop", "entry_price": 102.0, "stop": 98.0, "target": 110.0, "invalidation_price": 102.0}},
    {"name": "long_beyond_stop", "expect": false, "reference_close": 100.0, "thesis": {"direction": "long", "entry_kind": "stop", "entry_price": 102.0, "stop": 98.0, "target": 110.0, "invalidation_price": 97.0}},
    {"name": "short_below_entry", "expect": false, "reference_close": 100.0, "thesis": {"direction": "short", "entry_kind": "limit", "entry_price": 98.0, "stop": 102.0, "target": 90.0, "invalidation_price": 97.0}},
