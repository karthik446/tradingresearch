    {"name": "short_between_entry_and_stop", "expect": true, "reference_close": 100.0, "thesis": {"direction": "short", "entry_kind": "limit", "entry_price": 98.0, "stop": 102.0, "target": 90.0, "invalidation_price": 101.0}},
    {"name": "long_equal_to_stop", "expect": true, "reference_close": 100.0, "thesis": {"direction": "long", "entry_kind": "stop", "entry_price": 102.0, "stop": 98.0, "target": 110.0, "invalidation_price": 98.0}},
    {"name": "short_equal_to_stop", "expect": true, "reference_close": 100.0, "thesis": {"direction": "short", "entry_kind": "limit", "entry_price": 98.0, "stop": 102.0, "target": 90.0, "invalidation_price": 102.0}},
    {"name": "long_market_open_uses_the_snapshot_close", "expect": true, "reference_close": 100.0, "thesis": {"direction": "long", "entry_kind": "market_open", "entry_price": null, "stop": 96.0, "target": 108.0, "invalidation_price": 97.0}},
