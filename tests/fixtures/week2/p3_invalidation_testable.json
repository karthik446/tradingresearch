    {"name": "long_market_open_above_the_snapshot_close", "expect": false, "reference_close": 100.0, "thesis": {"direction": "long", "entry_kind": "market_open", "entry_price": null, "stop": 96.0, "target": 108.0, "invalidation_price": 101.0}},
    {"name": "short_market_open_below_the_snapshot_close", "expect": false, "reference_close": 100.0, "thesis": {"direction": "short", "entry_kind": "market_open", "entry_price": null, "stop": 104.0, "target": 92.0, "invalidation_price": 99.0}},
